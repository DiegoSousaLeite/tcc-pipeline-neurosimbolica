# Ferramentas pesadas
codeql/
codeql-bundle.tar.gz
repos/

# Cache Python
__pycache__/
*.pyc
src/__pycache__/
scripts/__pycache__/

# Cache de ferramenta (recriado a cada execução)
.pytest_cache/
.ruff_cache/

# Configuração sensível
.env

# Artefatos gerados (recriáveis, não commitar)
resultados_tcc*.csv
# Exceção: os CSVs da Parte 1 NÃO são recriáveis — dependiam de execução paga com
# CodeQL em ambiente que não existe mais — e a monografia cita os números deles.
!legacy/resultados_parte1/*.csv
*.sarif
pilot_*.csv
db_codeql/
# Cache do resultado simbólico: derivado de cache/ + Semgrep, e depende da
# versão do ruleset. Ao contrário de cache/, é reconstruível localmente.
cache_simbolico/
# Cópia do cache gravado sob a regra de pareamento ANTIGA (substring + fallback
# de alerta único), tirada antes da varredura que a substituiu. Uma entrada
# invalidada não é apagada, mas É sobrescrita quando o caso é recomputado no
# mesmo caminho — sem esta cópia não haveria como remedir o efeito da mudança.
# Remede: scripts/medir_pareamento.py --cache cache_simbolico_pre_estrito
cache_simbolico_pre_estrito/
# Rodadas da Parte 2. Os CSVs são reexecutáveis; o que precisa ser preservado
# de uma rodada é o manifesto (versionado à parte, quando a rodada for citada).
results/

# Slides da defesa. O diretório EXISTE localmente e não foi perdido: fica fora do
# versionamento porque 8 dos 11 MB são vendor/ (reveal.js + KaTeX vendorizados
# para rodar offline) e exports binários (.pptx, .pdf), que não produzem diff
# útil. O artefato citável de uma apresentação é o PDF final, entregue por outro
# canal.
apresentacao/

# tp_pairs*.json NÃO entra aqui de propósito: com repos/ apagado, regenerá-los
# exige refazer o fetch raso dos ~70 repos (~1 h). São entrada da pipeline.

# A monografia da Parte 2 passa a ser versionada (17/09/2026). O motivo é de
# escrita, não de engenharia: a partir daqui o texto muda com frequência e
# precisa de histórico — ver o que mudou entre duas revisões e poder voltar.
# As FONTES entram (.tex, .bib, figuras); o que o build gera fica de fora, em
# TCC2___Diego_Sousa_e_João_Artur_Leles/.gitignore.
#
# TCC1/TCC2 da Ana Luiza e do Pedro continuam fora: são PDFs de terceiros,
# usados como referência de estrutura, não artefatos deste trabalho.
TCC1___Ana_Luiz_e_Pedro.pdf
TCC2___Ana_Luiz_e_Pedro.pdf

# Configuração local do Claude Code: caminhos absolutos desta máquina e
# allowlist de permissões por sessão. Os comandos e skills do OpenSpec em
# .claude/commands/ e .claude/skills/ SÃO versionados; só este arquivo não é.
.claude/settings.local.json
