@article{woodside_moving_2013,
	title = {Moving beyond multiple regression analysis to algorithms: {Calling} for adoption of a paradigm shift from symmetric to asymmetric thinking in data analysis and crafting theory},
	volume = {66},
	issn = {0148-2963},
	shorttitle = {Moving beyond multiple regression analysis to algorithms},
	url = {http://www.sciencedirect.com/science/article/pii/S014829631200375X},
	doi = {10.1016/j.jbusres.2012.12.021},
	abstract = {This editorial suggests moving beyond relying on the dominant logic of multiple regression analysis (MRA) toward thinking and using algorithms in advancing and testing theory in accounting, consumer research, finance, management, and marketing. The editorial includes an example of testing an MRA model for fit and predictive validity. The same data used for the MRA is used to conduct a fuzzy-set qualitative comparative analysis (fsQCA). The editorial reviews a number of insights by prominent scholars including Gerd Gigerenzer's treatise that “Scientists' tools are not neutral.” Tools impact thinking and theory crafting as well theory testing. The discussion may be helpful for early career scholars unfamiliar with David C. McClelland's brilliance in data analysis and in introducing business research scholars to fsQCA as an alternative tool for theory development and data analysis.},
