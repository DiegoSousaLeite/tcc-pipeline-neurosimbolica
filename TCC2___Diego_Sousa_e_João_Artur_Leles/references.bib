	keywords = {COSONT, SLR process, case-based reasoning, concept extraction, evidence-based ontology, extended SLRONT version, knowledge acquisition, knowledge extraction, ontologies (artificial intelligence), ontology, software cost estimation, software engineering, software engineering research method, structured abstract, structured abstracts, systematic literature review},
