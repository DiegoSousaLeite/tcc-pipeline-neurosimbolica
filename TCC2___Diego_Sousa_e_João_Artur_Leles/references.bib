	keywords = {Business process management, Computer programming, End user development, End user development(EUD), Enterprise applications, Enterprise resource management, Extended versions, Industry, Information services, Information technology, Knowledge management, Programming environment, Programming skills, Service compositions, Service oriented architecture (SOA)},
	pages = {260--264},
}

