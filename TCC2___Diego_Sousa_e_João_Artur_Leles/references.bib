@article{houston_defectivity_2012,
	title = {Defectivity profiling with dynamic {COQUALMO}: {An} explication and product quality retrospective},
	volume = {24},
	copyright = {Copyright © 2010 John Wiley \& Sons, Ltd.},
	issn = {2047-7481},
	shorttitle = {Defectivity profiling with dynamic {COQUALMO}},
	url = {http://onlinelibrary.wiley.com/doi/abs/10.1002/smr.510},
	doi = {10.1002/smr.510},
	abstract = {A software development organization's process trustworthiness can be enhanced through development project retrospectives or postmortems, which seek to produce lessons from mistakes and successes in the project performance. Tool support for such retrospectives is usually limited to qualitative analysis. A new model, Dynamic COQUALMO, offers quantitative support through a defectivity profile that can be calibrated to a project's actual profile of defects found over time. The model inputs can then be varied to represent alternative project decisions and conditions, providing a basis for estimating the effects of project improvements on product quality. This paper describes Dynamic COQUALMO and demonstrates its use in a project retrospective. Copyright © 2010 John Wiley \& Sons, Ltd.},
	language = {en},
	number = {7},
	urldate = {2020-03-05},
	journal = {Journal of Software: Evolution and Process},
	author = {Houston, Dan and Buettner, Douglas and Hecht, Myron},
	year = {2012},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/smr.510},
	keywords = {COQUALMO, Dynamic COQUALMO, defect introduction and removal, defect profile, defectivity profiling, lessons learned, postmortem, residual defects, retrospective},
	pages = {803--814},
}

