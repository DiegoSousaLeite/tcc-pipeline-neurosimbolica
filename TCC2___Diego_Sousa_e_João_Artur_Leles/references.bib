	keywords = {API misuse detection, API-misuse, Benchmark testing, Computer bugs, Crypto API misuses, Crypto APIs, Cryptographic misuse, Cryptography, Java, MUBench, Static analysis, Tools, application program interfaces, benchmark, cryptographic APIs, cryptographic misuse classification, cryptography, dataset, open-source project, pattern classification, public domain software},
	pages = {96--100},
}

