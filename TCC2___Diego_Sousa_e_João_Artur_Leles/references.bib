@inproceedings{miah_development_2006,
	title = {Development of a design environment for end users to build the target-relevant decision support tools in rural industry},
	isbn = {1-920952-91-8 978-1-920952-91-4},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84870159539&partnerID=40&md5=374fba9361e24079ad5c095b43c94986},
	abstract = {Decision support systems (DSS) developed by end users have had limited success in rural operations. This paper will discuss the development stages of a new tool for improving the DSS development process in the rural industries. The object of this project is to develop an end user enabled design environment (EUEDE) which will allow a non-technical computer user to build target-relevant decision support tools. The resultant design environment aims to allow the end user to re-use and share their knowledge within a specific business context. This approach will facilitate flexibility to build relevant DSS's for an end user's specific decision requirements. The proposed design architecture will be transferable to other rural industries such as beef cattle and cotton. Theoretically, this approach anticipates extending development technologies of decision support tools to overcome traditional difficulties, by improving the context and relevance of development strategies and encourage end users to develop their own solutions. A qualitative field study using focus group approach will be adopted to acquire expert knowledge with an evolutionary prototyping approach being employed at this stage in order to construct a knowledge base for an expert system (ES). Utilising the decision making knowledge from the ES knowledge base, a generic design environment will be subsequently developed that will allow end user development of their own systems. The involvement of key industry stakeholders will be vital throughout both stages of EUEDE development. [S. Miah, D. Kerr and J. Gammack] © 2006.},
	language = {english},
	booktitle = {Quality and {Impact} of {Qualitative} {Research}: {QualIT} 2006, {Proceedings} of the 3rd {International} {Conference} on {Qualitative} {Research} in {IT} and {IT} in {Qualitative} {Research}},
	author = {Miah, S.J. and Kerr, D. and Gammack, J.},
	year = {2006},
	keywords = {Agriculture, Artificial intelligence, DSS, Decision support system (dss), Decision support systems, Deign environment, Design, Development technology, EUEDE, Einsteinium, Evolutionary prototyping, Expert systems, Qualitative field studies, Research, Rural application},
	pages = {75--85},
}

@inproceedings{mitra_diffusion_1996,
	title = {Diffusion theory approach to multimedia adoption},
	volume = {2},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-0030376122&partnerID=40&md5=e68ccb3093f6fbfb6caeeb402c16a0a4},
	abstract = {The recent past has witnessed an unprecedented boom in information technology, particularly in the area of multimedia. A marketing phenomenon that can be used to explain the rapid growth of multimedia technologies in the area of end-user computing is the diffusion of innovations. A study of multimedia diffusion phenomenon incorporating factors both internal and external to the organization will enable an organization to better manage the introduction and use of multimedia technologies. Diffusion theory seeks to explain how a new innovation, such as multimedia technology, will be accepted by individuals and firms and diffused through out the social fabric of an organization. This research develops a model of multimedia adoption based on diffusion theory and research propositions are put forth. The research propositions relate to the adoption process, the personal characteristics of the users, personal influence and opinion leadership of the users, the diffusion process and perceived innovation characteristics. An understanding of the process by which multimedia technologies will spread throughout an organization holds implications for organizations that are actively considering the introduction of these technologies as well as for academics.},
	language = {english},
	booktitle = {Proceedings - {Annual} {Meeting} of the {Decision} {Sciences} {Institute}},
