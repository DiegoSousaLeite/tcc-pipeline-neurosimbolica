	keywords = {Conferences, IFPUG function point data, IFPUG function point model, ISBSG dataset, Informatics, Internet, MARK-II, NESMA, Software Effort Estimation, Stochastic Gradient Boosting, Support Vector Regression, Web effort estimation, Web-based Applications, Web-based applications, Web-based software projects, analysts, effort estimation models, learning (artificial intelligence), machine learning techniques, regression analysis, stochastic gradient boosting, support vector machines, support vector regression kernels},
	pages = {973--979},
}

