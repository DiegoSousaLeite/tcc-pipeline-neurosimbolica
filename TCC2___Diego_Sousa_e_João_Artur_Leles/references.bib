	keywords = {Access control, Computer crime, Computer security, Cryptographic protocols, Ethics, Floods, Information security, Laboratories, Microeconomics, Protection, adverse selection, asymmetric information, economics, information security, liability dumping, moral hazard, network externalities, security of data},
	pages = {358--365},
}

@inproceedings{ardente_combining_2013,
