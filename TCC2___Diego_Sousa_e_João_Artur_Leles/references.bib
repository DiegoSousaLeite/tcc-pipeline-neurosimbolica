@incollection{eckert_quantitative_2014,
	address = {Cham},
	title = {A {Quantitative} {Analysis} of {Common} {Criteria} {Certification} {Practice}},
	volume = {8647},
	isbn = {978-3-319-09769-5 978-3-319-09770-1},
	url = {http://link.springer.com/10.1007/978-3-319-09770-1_12},
	abstract = {The Common Criteria (CC) certiﬁcation framework deﬁnes a widely recognized, multi-domain certiﬁcation scheme that aims to provide security assurances about IT products to consumers. However, the CC scheme does not prescribe a monitoring scheme for the CC practice, raising concerns about the quality of the security assurance provided by the certiﬁcation and questions on its usefulness. In this paper, we present a critical analysis of the CC practice that concretely exposes the limitations of current approaches. We also provide directions to improve the CC practice.},
