@article{tondel_collaborative_2019,
	title = {Collaborative security risk estimation in agile software development},
	volume = {26},
	issn = {2056-4961, 2056-4961},
	url = {https://www.emerald.com/insight/content/doi/10.1108/ICS-12-2018-0138/full/html},
	doi = {10.1108/ICS-12-2018-0138},
	abstract = {Purpose – Today, agile software development teams in general do not adopt security risk-assessment practices in an ongoing manner to prioritize security work. Protection Poker is a collaborative and lightweight software security risk-estimation technique that is particularly suited for agile teams. Motivated by a desire to understand why security risk assessments have not yet gained widespread adoption in agile development, this study aims to assess to what extent the Protection Poker game would be accepted by agile teams and how it can be successfully integrated into the agile practices.},
