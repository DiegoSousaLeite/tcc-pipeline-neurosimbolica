@inproceedings{romero-fuerte_work--progress_2015,
	title = {Work-in-progress: {Online} teamwork skills taking team based learning to the digital classroom},
	shorttitle = {Work-in-progress},
	doi = {10.1109/ICBL.2015.7387636},
	abstract = {Two instructors partnered with an instructional designer to integrate their separate courses into a single online course covering both elementary statistics and epidemiology. High enrollment was expected (175-200 graduate level nursing students) and team-based learning (TBL) principles were adopted. This paper documents the experiences of the course development team regarding the design, implementation and evaluation of team-based learning methodology in an online environment. Through the application of instructional design principles, this paper suggests how online collaboration tools can be used to improve student perception of the effectiveness of online teamwork, and their satisfaction with the overall design of the course.},
	booktitle = {2015 {International} {Conference} on {Interactive} {Collaborative} and {Blended} {Learning} ({ICBL})},
	author = {Romero-Fuerte, Elizabeth and Steffen, Alana D. and Eleirawi, Kamal},
