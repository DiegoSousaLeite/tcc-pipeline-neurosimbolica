	keywords = {Analytical models, Change risk, Computer bugs, Feature extraction, Measurement, Predictive models, Software quality, change risk classification models, churn metrics, code changes, code ownership, code ownership metrics, code quality, code repository, configuration management, directory level, file metrics, fix inducing changes, learning (artificial intelligence), machine learning, machine learning model, pattern classification, program debugging, software maintenance, software metrics, software quality, software repositories, version histories},
