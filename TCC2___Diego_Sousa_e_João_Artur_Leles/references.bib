	address = {Paderborn, Germany},
	series = {{ESEC}/{FSE} 2017},
	title = {{FOSS} version differentiation as a benchmark for static analysis security testing tools},
	isbn = {978-1-4503-5105-8},
	url = {http://doi.org/10.1145/3106237.3121276},
