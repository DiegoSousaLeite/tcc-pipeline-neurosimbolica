	keywords = {Computer architecture, Cost accounting, Quality management, Software, Training, architecture review boards, computer science education, educational courses, grading criteria, quality management plans, real client graduate level software engineering course, reflection-in-action techniques, software engineering, validation process improvement practice, verification \& validation process practice},
	pages = {304--313},
