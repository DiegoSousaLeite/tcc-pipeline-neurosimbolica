	month = may,
	year = {2019},
	keywords = {Analytical models, Automated Tool, Data models, Issue Report Filtering, Issue Repository, Market research, Reliability Analysis, SRGM, STRAIT features downloading, Software, Software Reliability Growth Model, Software reliability, Tools, data filtering, data processing, essential attribute, free source tool, multiple data snapshots, open-source tool, regression analysis, regression-based models, safety-critical, safety-critical software, software quality, software reliability, software reliability growth analysis},
