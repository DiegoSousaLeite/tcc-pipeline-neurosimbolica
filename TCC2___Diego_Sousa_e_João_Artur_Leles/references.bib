@inproceedings{conradi_reflections_2005,
	title = {Reflections on conducting an international survey of software engineering},
	doi = {10.1109/ISESE.2005.1541830},
	abstract = {Component-based software engineering (CBSE) with commercial-off-the-shelf (COTS) or open source software (OSS) components are more and more frequently being used in industrial software development. We therefore need to issue experience-based guidelines for the evaluation, selection and integration of such components. We have performed a survey on industrial COTS/OSS development in three countries - Norway, Italy and Germany. Concrete survey results, e.g. on risk management policies and process tailoring, are not being described here, but in other papers. This is a method paper, reporting on the challenges, approaches and experiences gained by conducting the main survey. The main contributions are as follows: At best we can achieve a stratified-random sample of ICT companies, followed by a convenience sample of relevant projects. This is probably the ftirst software engineering survey using census type data, and has revealed that the entire sampling and contact process can be unexpectedly expensive. It is also hard to avoid national variations in the total process, possibly leading to uncontrollable method biases},
	booktitle = {2005 {International} {Symposium} on {Empirical} {Software} {Engineering}, 2005.},
	author = {Conradi, R. and Li, J. and Slyngstad, O. P. N. and Kampenes, V. B. and Bunse, C. and Morisio, M. and Torchiano, M.},
	month = nov,
	year = {2005},
	keywords = {Books, CBSE, COTS, Communication industry, Communications technology, Computer industry, Costs, DP industry, ICT companies, Large-scale systems, Reflection, Software engineering, Software quality, Time to market, commercial-off-the-shelf, component-based software engineering, industrial software development, object-oriented programming, open source software component, process tailoring, public domain software, risk management, software development management, software engineering, software engineering survey, software packages},
	pages = {10 pp.--},
}

