	keywords = {Control systems, History, Java, Open source software, Systematics, Task analysis, Tools, commit history, configuration management, history slices, history slicing, open source systems, program slicing, software maintenance, systematic edits, systematic edits detection, version control, version control systems},
	pages = {555--559},
}

