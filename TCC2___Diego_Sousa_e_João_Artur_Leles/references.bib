@article{borte_role_2012,
	title = {The role of social interaction in software effort estimation: {Unpacking} the “magic step” between reasoning and decision-making},
	volume = {54},
	issn = {09505849},
	shorttitle = {The role of social interaction in software effort estimation},
	url = {http://linkinghub.elsevier.com/retrieve/pii/S0950584912000511},
	doi = {10.1016/j.infsof.2012.03.002},
	abstract = {Objective: This paper examines the use of concepts in software effort estimation by analysing group work as communicative practice. The objective is to improve our understanding of how software professionals invoke different types of knowledge when talking, reasoning and reaching a decision on a software effort estimate. Method: Estimation meetings in the industry where planning poker was used as the estimation method have been video recorded and analysed by means of the interaction analysis technique, focusing on the communicative and collaborative aspects of the group work. Results: The user story mediates the types of resources and knowledge needed to solve the task. Concepts from the knowledge domain are used to frame the task and allow the participants to reach consensus, sufﬁcient to take the next step in the problem-solving activity. Individual knowledge seems to be the dominating orientation when it comes to specifying the work needed for solving the tasks. Conclusion: The step from reasoning to decision-making has been called the ‘‘magic step’’ in software effort estimation. We argue that the magic step is found in the analysis of the social interaction in which the concepts used are anchored in the knowledge domain of software engineering and in the historical experiences of the participants and subsequently become activated. We propose that by taking a socio-cultural perspective on concepts in activities, the ways in which software professionals reach a decision can be unpacked. The paper contributes to an understanding of the role of concepts in group work and of software effort estimation as a speciﬁc work practice.},
	language = {english},
	number = {9},
	urldate = {2018-03-22},
	journal = {Information and Software Technology},
	author = {Børte, Kristin and Ludvigsen, Sten R. and Mørch, Anders I.},
	month = sep,
	year = {2012},
	pages = {985--996},
}

@article{mittas_framework_2015,
