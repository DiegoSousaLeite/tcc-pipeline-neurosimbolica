@article{mcgraw_four_2016,
	title = {Four {Software} {Security} {Findings}},
	volume = {49},
	issn = {0018-9162},
	doi = {10.1109/MC.2016.30},
	abstract = {Analyzing data from 78 firms using the Building Security In Maturity Model (BSIMM) revealed four truths about software security that will help firms protect and secure their assets. Software security continues to grow and evolve, currently accounting for more than 10 percent of global IT security revenue worldwide. On the surface, it seems obvious that we must make software systems secure from the start, but opinions vary as to implementation. Through a multiyear process of observing and measuring security initiatives, we can move beyond opinion into the realm of fact. WHAT follows are four indic},
