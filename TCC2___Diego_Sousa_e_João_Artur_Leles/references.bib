@inproceedings{edwards_evaluation_2017,
	title = {Evaluation of {Software} {Vulnerabilities} in {Vehicle} {Electronic} {Control} {Units}},
	doi = {10.1109/SecDev.2017.26},
	abstract = {Automotive electronic control units (ECUs) have been the focus of many security researchers who have demonstrated the ability to affect the deterministic operation of safety critical vehicle cyber physical systems. Flaws in software design that have direct impacts to the functional safety of a target vehicle have been discovered. The rapid increase in data connectivity within a modern automobile has broadened the attack surface, allowing adversaries remote access to in-vehicle networks and control system software. This abstract discusses the results of static code analysis performed on automotive production software source code using reference coding standards such as MISRA and CERT C secure coding guidelines, in an attempt to identify the most critical software bugs which are likely to remain in the vehicle, undetected, as zero-day security vulnerabilities.},
	booktitle = {2017 {IEEE} {Cybersecurity} {Development} ({SecDev})},
	author = {Edwards, Jesse and Kashani, Ameer and Iyer, Gopalakrishnan},
	month = sep,
	year = {2017},
	keywords = {Automotive, Automotive engineering, CERT C, CERT C secure coding guidelines, CVE, CWE, Computer bugs, Cybersecurity, Electronic Control Units, Encoding, MISRA, Metals, Security, Software, Software Vulnerabilities, Standards, Static Code Analysis, adversaries remote access, attack surface, automobiles, automotive electronic control units, automotive electronics, automotive engineering, automotive production software source code, control system software, critical software bugs, data connectivity, deterministic operation, functional safety, in-vehicle networks, modern automobile, program debugging, program diagnostics, reference coding standards, road safety, safety critical vehicle cyber physical systems, safety-critical software, security of data, security researchers, software design, software vulnerabilities, static code analysis, vehicle electronic control units, zero-day security vulnerabilities},
	pages = {83--84},
}

@inproceedings{rosa_simple_2014,
	address = {New York, NY, USA},
	series = {{ESEM} '14},
	title = {Simple {Empirical} {Software} {Effort} {Estimation} {Model}},
	isbn = {978-1-4503-2774-9},
	url = {http://doi.acm.org/10.1145/2652524.2652558},
	doi = {10.1145/2652524.2652558},
	abstract = {Context: An effort estimation model with more than 20 parameters is not very useful at early conceptual phase if you don't have a logical approach for specifying the input values. Goal: This paper presents a simple approach for predicting software development effort. Method: The regression model uses product size and application types to predict effort. Product size is measured in terms of the equivalent source lines of code. The analysis is based on empirical data collected from 317 very recent projects implemented within the United States Department of Defense over the course of nine years beginning in 2004. Result: Statistical results showed that source lines of code and application type are significant contributors to development effort. Conclusion: The equation is simpler and more viable to use for early estimates than traditional parametric cost models. The effect of product size on software effort shall be interpreted along with application domain.},
