@article{tondel_it_2020,
	title = {{IT} {Security} {Is} {From} {Mars}, {Software} {Security} {Is} {From} {Venus}},
	volume = {18},
	issn = {1558-4046},
	doi = {10.1109/MSEC.2020.2969064},
	abstract = {The divide between IT security and software security can result in the neglect of proper software security. This divide can be bridged by establishing a formal security champion role in the development team and conducting collaborative risk-based security activities.},
	number = {4},
	journal = {IEEE Security and Privacy},
	author = {Tondel, Inger Anne and Gilje Jaatun, Martin and Soares Cruzes, Daniela},
	month = jul,
