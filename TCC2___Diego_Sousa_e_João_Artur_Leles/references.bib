@inproceedings{butler_security_2002,
	title = {Security attribute evaluation method: a cost-benefit approach},
	shorttitle = {Security attribute evaluation method},
	doi = {10.1109/ICSE.2002.1007971},
	abstract = {Conducting cost-benefit analyses of architectural attributes such as security has always been difficult, because the benefits are difficult to assess. Specialists usually make security decisions, but program managers are left wondering whether their investment in security is well spent. The paper summarizes the results of using a cost-benefit analysis method called SAEM to compare alternative security designs in a financial and accounting information system. The case study presented starts with a multi-attribute risk assessment that results in a prioritized list of risks. Security specialists estimate countermeasure benefits and how the organization's risks are reduced. Using SAEM, security design alternatives are compared with the organization's current selection of security technologies to see if a more cost-effective solution is possible. The goal of using SAEM is to help information-system stakeholders decide whether their security investment is consistent with the expected risks.},
	booktitle = {Proceedings of the 24th {International} {Conference} on {Software} {Engineering}. {ICSE} 2002},
	author = {Butler, S. A.},
	month = may,
	year = {2002},
	keywords = {Computer science, Cost benefit analysis, Data security, Information management, Information security, Investments, Permission, Risk analysis, Risk management, SAEM, Technology management, alternative security designs, architectural attributes, cost-benefit analyses, cost-benefit analysis, cost-benefit approach, countermeasure benefits, expected risks, financial data processing, financial/accounting information system, information-system stakeholders, multi-attribute risk assessment, prioritized risks, program managers, risk management, security attribute evaluation method, security decisions, security of data, security specialists},
