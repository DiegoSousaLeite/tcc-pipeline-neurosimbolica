}

@inproceedings{smith_safety_2000,
	title = {Safety, environmental and equipment protection integrity level selection},
	volume = {404},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-0033666506&partnerID=40&md5=0fceb8703af4a3522cd5d0731185364b},
	abstract = {NOVA Chemicals Corporation (`NOVA Chemicals') has adopted the RESPONSIBLE CARE program as the basis for its overall safety, health, environment and risk program. Responsible Care is a comprehensive program which was initiated by the Canadian Chemical Producers' Association (`CCPA') and has since been adopted by the Chemical Manufacturers' Association (`CMA') in the United States as well as by chemical industry associations in over 40 countries world-wide. Responsible Care is built around a set of guiding principles and codes of practice which require program participants to commit to the responsible management of the total life cycle of their products. Ongoing hazard identification and the tracking and management of environmental risks are essential elements of NOVA Chemicals' Responsible Care program. The selection of safety integrity levels (SIL) follows a Corporate Loss Prevention Standard (LPS). The LPS is based on industry standards and procedures developed by a team of NOVA Chemicals Safety Engineers. The LPS is a risk based standard designed to ensure the right amount of protection is applied. Credit can be taken for other related non-safety instrumented systems such as pressure relief valves. An incremental risk reduction technique is followed to increase the effectiveness of protective measures. A hazard and risk analysis is performed to identify potential hazards and associated level of risk. Integrity levels for Safety, Environment and Equipment/Business Protection are determined for the equipment under control (EUC). A Safety Integrity Level Determination Template is used to guide and document the evaluation process. A team performs the qualitative procedure using Risk Graphs to determine the SIL for the proposed installation. This paper will describe the process and provide examples.},
	language = {english},
	booktitle = {{ISA} {TECH}/{EXPO} {Technology} {Update} {Conference} {Proceedings}},
	publisher = {ISA, Research Triangle Park, NC, United States},
	author = {Smith, Brian T.},
	year = {2000},
	keywords = {Codes (standards), Hazards, Independent protection layers, Risk management, Safety instrument systems, Safety integrity levels, environmental protection},
	pages = {143--156},
}

@inproceedings{mohammad_secure_2017,
	title = {Secure software engineering: {Evaluation} of emerging trends},
	shorttitle = {Secure software engineering},
	doi = {10.1109/ICITECH.2017.8079952},
	abstract = {With the dramatic increase in the number of software security problems, a growing body of research in how to integrate security within software development is notable. Many security approaches have appeared to solve security problems by applying a set of activities through Software Development Life Cycle (SDLC). Among the top approaches are McGraw's Touchpoints, Comprehensive Lightweight Application Security Process (CLASP) from Open Web Application Security Project (OWASP) organization, and Microsoft Security Development Lifecycle (SDL). In this paper, we evaluate these three security approaches by discussing their common process, strength, and limitations. Moreover, we discuss why these approaches do not effectively increase software security. Finally, we set the stage for a future framework to enhance and simplify the application of various security activities within the SDLC.},
	booktitle = {2017 8th {International} {Conference} on {Information} {Technology} ({ICIT})},
	author = {Mohammad, A. and Alqatawna, J. and Abushariah, M.},
	month = may,
