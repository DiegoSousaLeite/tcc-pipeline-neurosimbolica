	year = {2010},
	keywords = {Analytical models, Approximation methods, Cognitive science, Complexity theory, Contracts, Software, abstraction-for-validation technique, approximation theory, behaviour models, behavioural validation, code understanding, contract conformance, finite state abstraction, finite state approximation, software engineering, software engineering artefact},
