@article{molleri_empirically_2019,
	title = {An {Empirically} {Evaluated} {Checklist} for {Surveys} in {Software} {Engineering}},
	url = {http://arxiv.org/abs/1901.09850},
	abstract = {Context: Over the past decade Software Engineering research has seen a steady increase in survey-based studies, and there are several guidelines providing support for those willing to carry out surveys. The need for auditing survey research has been raised in the literature. Checklists have been used to assess different types of empirical studies, such as experiments and case studies. Objective: This paper proposes a checklist to support the design and assessment of survey-based research in software engineering grounded in existing guidelines for survey research. We further evaluated the checklist in the research practice context. Method: To construct the checklist, we systematically aggregated knowledge from 14 methodological papers supporting survey-based research in software engineering. We identified the key stages of the survey process and its recommended practices through thematic analysis and vote counting. To improve our initially designed checklist we evaluated it using a mixed evaluation approach involving experienced researchers. Results: The evaluation provided insights regarding limitations of the checklist in relation to its understanding and objectivity. In particular, 19 of the 38 checklist items were improved according to the feedback received from its evaluation. Finally, a discussion on how to use the checklist and what its implications are for research practice is also provided. Conclusion: The proposed checklist is an instrument suitable for auditing survey reports as well as a support tool to guide ongoing research with regard to the survey design process.},
	urldate = {2019-02-04},
	journal = {arXiv:1901.09850 [cs]},
	author = {Molléri, Jefferson Seide and Petersen, Kai and Mendes, Emilia},
	month = jan,
	year = {2019},
	keywords = {Computer Science - Software Engineering},
}

@article{shah_systematic_nodate,
	title = {Systematic {Literature} {Review} on {Risk} {Management} in {Security} {Requirement} {Engineering}},
	abstract = {Risk in security requirements is of great importance now a days because of greater impact and recent security threats faced by reputed firms in the industry. The assessment of security risk is most challenging due to risk factors such as severity level of attack are not numerically measurable in early requirement engineering phases. This make to select the proper solution for risk mitigation in requirement engineering phase. In the literature review we included 50 studies base on risk in security requirements the main objective of performing this survey is to understanding the current state or art about risk in security requirements in requirements engineering including the identification of most occurring risk in security requirements, factors causing risk in security requirements and techniques used to mitigate those risk. The comparison on risk mitigation tools and techniques is also performed in this literature review.},
