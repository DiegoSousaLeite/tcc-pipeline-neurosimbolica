	publisher = {The Hillside Group},
	author = {Preschern, Christopher},
	month = oct,
	year = {2012},
	keywords = {common criteria, security certification, security functional requirements, security tactics},
	pages = {1--17},
}

@inproceedings{kuusinen_designing_2013,
	title = {Designing {User} {Experience} for {Mobile} {Apps}: {Long}-{Term} {Product} {Owner} {Perspective}},
	volume = {1},
	shorttitle = {Designing {User} {Experience} for {Mobile} {Apps}},
	doi = {10.1109/APSEC.2013.77},
	abstract = {The ways people consume content and use applications with different types of devices are fundamentally different. When designing applications for enterprise use, user experience (UX) must typically be addressed during the upfront design of the application. Due to the importance of upfront design regarding UX, the product owner (PO), responsible for the success of the product, must manage UX related tasks. In this paper, we present results of a study on the views of a PO to UX of mobile apps. The study is based on long-term data from three mobile app projects that were supervised by a single PO to reflect how the view evolves over time. As a result, we show that the fashion UX work is included in a project has a significant impact on the outcome and the satisfaction of the PO.},
	booktitle = {2013 20th {Asia}-{Pacific} {Software} {Engineering} {Conference} ({APSEC})},
	author = {Kuusinen, Kati and Mikkonen, Tommi},
	month = dec,
	year = {2013},
	note = {ISSN: 1530-1362},
	keywords = {Context, Guidelines, Measurement, Mobile communication, Schedules, Usability, agile methods, mobile apps, user experience},
	pages = {535--540},
}

