@article{catenassi_cao_2018,
	title = {A unção de {Betânia} no contexto da traição de {Jesus} ({Marcos} 14,1-11): {Aspectos} de estilo e narratividade},
	volume = {1},
	copyright = {Copyright (c) 2018 ReBiblica},
