	address = {Cham},
	title = {Wideband {Delphi}},
	isbn = {978-3-319-03629-8},
	url = {https://doi.org/10.1007/978-3-319-03629-8_12},
	abstract = {Wideband Delphi represents expert-based estimation with a structured group consensus approach. Unlike most of the known effort estimation methods, it does not actually require a detailed description of the problem being estimated—that is, the scope of the project to be estimated. Determination of the exact project work items as well as their breakdown into detailed activities and tasks can be a part of the estimation process.},
