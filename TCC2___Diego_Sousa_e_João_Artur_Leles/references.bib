	keywords = {API, API tips, CNN, Convolutional neural networks, Data mining, Deep learning, DeepTip, Encoding, Feature extraction, Informatics, Software, Stack Overflow users, Web sites, application program interfaces, convolutional neural nets, convolutional neural network architectures, deep learning, deep learning-based approach, developer answers, developer question, extensive empirical experiments, high-quality tips, information overload, irrelevant information, learning (artificial intelligence), massive user-generated content, question and answer websites, question answering (information retrieval), sentence classification, tip extraction, useful information},
	pages = {321--332},
}

